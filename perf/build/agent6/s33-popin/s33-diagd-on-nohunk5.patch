+// #33 diagnostic (d) (Agent 10 S2): log resolves that follow draws skipped while
+// their pipeline was in creation. A render-to-texture pass that loses draws and
+// is resolved only once stays wrong until it's drawn again; these lines measure
+// how often that can happen, with d3d12_pipeline_creation_no_wait on or off.
+REXCVAR_DEFINE_BOOL(d3d12_resolve_after_drop_log, false, "GPU/D3D12",
+                    "Log resolves issued after draws were skipped for a pipeline in "
+                    "creation, and when each such resolve target is next resolved with "
+                    "no skipped draws (diagnostic for d3d12_pipeline_creation_no_wait)")
+    .lifecycle(rex::cvar::Lifecycle::kRequiresRestart);
