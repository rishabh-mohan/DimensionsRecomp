+
+// Diagnostic (d) state. Only touched on the command thread (IssueDraw,
+// IssueCopy), and only while d3d12_resolve_after_drop_log is set. Skipped draws
+// aren't matched to render targets: every skipped draw since the last resolve
+// counts against the next one (an upper bound on the exposure).
+struct ResolveAfterDrop {
+  uint64_t drops_since_resolve = 0;
+  uint64_t resolves = 0;
+  uint64_t after_drop = 0;
+  uint64_t healed = 0;
+  uint64_t lines = 0;
+  // Resolve destination base -> the resolve ordinal that last followed drops.
+  std::unordered_map<uint32_t, uint64_t> tainted;
+};
+ResolveAfterDrop resolve_after_drop;
+constexpr uint64_t kResolveAfterDropMaxLines = 4096;
+
+// A resolve to dest_base was just recorded. copies: it writes memory (it isn't
+// clear-only).
+void NoteResolveAfterDrop(uint32_t dest_base, bool copies) {
+  ResolveAfterDrop& d = resolve_after_drop;
+  ++d.resolves;
+  const uint64_t drops = d.drops_since_resolve;
+  d.drops_since_resolve = 0;
+  if (!copies) {
+    return;
+  }
+  if (drops) {
+    ++d.after_drop;
+    const bool first = d.tainted.insert_or_assign(dest_base, d.resolves).second;
+    if (d.lines < kResolveAfterDropMaxLines) {
+      ++d.lines;
+      REXGPU_INFO(
+          "resolve after drop: dest {:08X} after {} skipped draws ({}) | resolves {}, "
+          "after drops {}, healed {}, tainted {}",
+          dest_base, drops, first ? "new" : "again", d.resolves, d.after_drop, d.healed,
+          d.tainted.size());
+    }
+  } else if (d.tainted.erase(dest_base)) {
+    ++d.healed;
+    if (d.lines < kResolveAfterDropMaxLines) {
+      ++d.lines;
+      REXGPU_INFO(
+          "resolve after drop: dest {:08X} resolved clean again | resolves {}, "
+          "after drops {}, healed {}, tainted {}",
+          dest_base, d.resolves, d.after_drop, d.healed, d.tainted.size());
+    }
+  }
+  if (d.lines == kResolveAfterDropMaxLines) {
+    ++d.lines;
+    REXGPU_INFO("resolve after drop: {} lines logged, no more from here on",
+                kResolveAfterDropMaxLines);
+  }
+}
 
