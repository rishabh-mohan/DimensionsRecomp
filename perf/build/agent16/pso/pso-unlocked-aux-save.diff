+  // LEGO_NATIVE_PSO_SAVE_UNLOCKED: like SnapshotPipelineLibrary, but Serialize
+  // runs without mutex_, so draw-time load()/store() never queue behind the
+  // copy. The library itself is free-threaded; loads proceed during Serialize
+  // and the driver holds back a concurrent StorePipeline until it is done. A
+  // store between GetSerializedSize and Serialize makes Serialize fail with
+  // E_INVALIDARG (bench/agent6/d3d12_library_probe.md), so a copy is accepted
+  // only if Serialize succeeded and the library still has the size it was
+  // queried at; otherwise it is retried with a fresh zero-filled buffer (never
+  // a reused one, see pipeline_snapshot.h). Without a race the bytes are the
+  // ones the locked path writes. Returns false to fall back to the locked path.
+  template <class Query>
+  bool SnapshotUnlocked(PipelineSnapshot& snapshot, uint64_t& saved, Query& query) {
+    using namespace snapshot_detail;
+    const auto held = [&](Clock::time_point locked) {
+      const int64_t micros = Micros(Clock::now() - locked);
+      snapshot.lock_us += micros;
+      if (micros > snapshot.max_lock_us) snapshot.max_lock_us = micros;
+    };
+    // Each attempt is two locked passes: query and allocate, query and copy.
+    const auto give_up = [&] {
+      snapshot.data.reset();
+      snapshot.capacity = 0;
+      snapshot.size = 0;
+      snapshot.status = PipelineSnapshot::Status::kFailed;
+      return false;
+    };
+    bool dirty = false;  // the buffer has been handed to Serialize
+    for (;;) {
+      std::size_t size = 0;
+      uint64_t counted = 0;
+      {
+        std::lock_guard lock(mutex_);
+        const auto locked = Clock::now();
+        ++snapshot.passes;
+        size = query();
+        counted = unsaved_;
+        held(locked);
+      }
+      snapshot.wanted = size;
+      if (!size) {
+        snapshot.status = PipelineSnapshot::Status::kNothing;
+        return true;
+      }
+      if (dirty || size > snapshot.capacity) {
+        if (snapshot.passes >= 2 * kUnlockedSaveAttempts) return give_up();
+        if (snapshot.capacity && !dirty) ++snapshot.retries;
+        snapshot.data.reset();
+        snapshot.capacity = 0;
+        dirty = false;
+        const std::size_t bytes = Capacity(size);
+        const auto start = Clock::now();
+        snapshot.data = Allocate(bytes);
+        snapshot.alloc_us += Micros(Clock::now() - start);
+        if (!snapshot.data) {
+          snapshot.status = PipelineSnapshot::Status::kNoMemory;
+          return true;
+        }
+        snapshot.capacity = bytes;
+        continue;  // The library may have grown during the allocation.
+      }
+      dirty = true;
+      const auto copy_start = Clock::now();
+      const HRESULT serialized = library_->Serialize(snapshot.data.get(), size);
+      snapshot.copy_us += Micros(Clock::now() - copy_start);
+      bool accepted = false;
+      {
+        std::lock_guard lock(mutex_);
+        const auto locked = Clock::now();
+        accepted = SUCCEEDED(serialized) && library_->GetSerializedSize() == size;
+        if (accepted) {
+          // Stores after the query are not in this copy; they stay unsaved.
+          saved = counted;
+          unsaved_ -= std::min(unsaved_, counted);
+          ++stats_.saves;
+        }
+        held(locked);
+      }
+      if (accepted) {
+        snapshot.size = size;
+        snapshot.status = PipelineSnapshot::Status::kCopied;
+        return true;
+      }
+      ++snapshot.retries;
+      if ((FAILED(serialized) && serialized != E_INVALIDARG) || snapshot.passes >= 2 * kUnlockedSaveAttempts)
+        return give_up();
+    }
+  }
