+#define REX_LOG_NOISY_IMPL(cat, lvl, ...)                                     \
+  do {                                                                        \
+    if (!::rex::detail::LogLevelMayBeEnabled(lvl) || !REXCVAR_GET(log_noisy)) \
+      break;                                                                  \
+    REX_LOG_IMPL(cat, lvl, __VA_ARGS__);                                      \
   } while (0)
 
