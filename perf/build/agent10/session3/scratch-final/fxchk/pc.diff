+                if ($id -eq 'fx4' -and -not (B 'fx1' '')) { Say 'fx fx4: no fx1 run for --pair'; $ex = @() }
+                $x = FX $id $c $ex
+                FxMark $id $x (HintOk $id) "s4b_check hint PASS? $(HintOk $id)"
