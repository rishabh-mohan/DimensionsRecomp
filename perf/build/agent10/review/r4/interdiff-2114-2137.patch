+CodegenContext ControlContext(const fs::path& root, const std::vector<bool RecompilerConfig::*>& flags) {
+  constexpr std::array<uint32_t, 7> code{0x2C030001, 0x7C8903A6, 0x30A50001, 0x7CC02028,
