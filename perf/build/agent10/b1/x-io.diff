+  std::shared_lock<std::shared_mutex> read_lock(unlocked_read_lock_, std::defer_lock);
+  if (unlocked) {
+    read_lock.lock();
+  } else {
+    lock.lock();
+  }
+  X_STATUS result = X_STATUS_SUCCESS;
