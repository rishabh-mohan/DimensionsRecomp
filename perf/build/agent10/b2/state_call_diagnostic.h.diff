+// The last value requested in this recording, compared bytewise as the API receives it.
+template <class T>
+struct LastRequest {
+  T value{};
+  bool set = false;
+  bool Same(const T& next) {
+    const bool same = set && std::memcmp(&value, &next, sizeof(T)) == 0;
+    value = next;
+    set = true;
+    return same;
+  }
 };
 
