+def recovered_hang(s):
+    """A run whose only trouble is the lock watchdog: closed by the harness with exit code 0, no crash event or
+    WER report, every dump is the watchdog's hang-<pid>.dmp of this game, and game.log has a STUCK-LOCK episode.
+    The game came back by itself, so it is not reported as a crash. It still needs a look (run-game.ps1 still
+    exits 1 for any dump, and route-report.ps1 still fails 'no crash')."""
+    run = s.get("run") or {}
+    dumps = run.get("dumps") or []
+    if not dumps or run.get("exit_code") != 0 or run.get("exited_early"):
+        return False
+    if run.get("crash_events") or run.get("wer_seen") or not s["log"].get("stuck_locks"):
+        return False
+    pid = run.get("pid")
+    for d in dumps:
+        m = HANG_DUMP.match(str(d).replace("\\", "/").rsplit("/", 1)[-1])
+        if not m or (pid is not None and m["pid"] != str(pid)):
+            return False
+    return True
+
