@@ -245,6 +287,45 @@ while ((Get-Date) -lt $end) {
             # #33 row 1a after s33off, row 1b after s33offsf (both arms' runs needed; else a SKIP line)
             if ($id -eq 's33off') { S33 $id 'base' (B 's33base' '') 'off' $c }
