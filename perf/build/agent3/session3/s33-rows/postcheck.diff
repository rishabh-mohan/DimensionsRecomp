+            # #33 rows 2, 4, 5, 6, (d): kit + the row's reports (S33-ROWS-PLAN.md). No marker is written here: M3 reads
+            # logs\<id>.check.txt + logs\<id>.s33.txt and creates the next go-<id> by hand (stop at the first FAIL).
+            $s33o = B 's33offsf' ''
+            switch -Regex ($id) {
+                '^s33onsf$' {
+                    $k = S33K $id 's33-row2' 'offsf' @("offsf=$s33o", "onsf=$c")
+                    $fl = S33R $id 's33_fields' 's33fields' @('build\agent6\s33-popin\s33_fields.py', '--arm', "offsf=$s33o", '--arm', "onsf=$c", '--out', (Join-Path $logs "$id.s33fields.report.txt"))
