+                    $sj = S33R $id 'slowframe_join' 'sfjoin' @('build\agent6\attract-stalls\slowframe_join.py', $c, '--min-ms', '250')
+                    Say "s33 $id row 2: kit $k, s33_fields $fl, attrib $at, slowframe_join $sj"
+                }
+                '^s33stop\d$' {
+                    $k = S33K $id "s33-row4-$id" 'offsf' @("offsf=$s33o", "onstop=$c")
+                    $o = S33R $id 's33_onstop' 'onstop' @('build\agent3\session3\s33-rows\s33_onstop.py', $c, '--json', (Join-Path $logs "$id.onstop.json"))
+                    Say "s33 $id row 4: kit $k, s33_onstop $o (0 counts, 3 does not count = run a spare, 1 FAIL)"
+                }
+                '^s33offw$' { $k = S33K $id 's33-row5-offw' 'offsf' @("offsf=$s33o", "offwarm=$c"); Say "s33 $id row 5 (offwarm vs offsf): kit $k" }
+                '^s33onw$' {
+                    $ow = B 's33offw' ''
+                    $k = S33K $id 's33-row5' 'offwarm' @("offwarm=$ow", "onwarm=$c")
+                    # M10 C2: row 5 s33_fields (late drops 0, onwarm drops only right after the storage load), read by hand
+                    $fl = if ($ow) { S33R $id 's33_fields' 's33fields' @('build\agent6\s33-popin\s33_fields.py', '--arm', "offwarm=$ow", '--arm', "onwarm=$c", '--out', (Join-Path $logs "$id.s33fields.report.txt")) } else { 'SKIP' }
+                    Say "s33 $id row 5: kit $k, s33_fields $fl"
+                }
+                '^s33g(thr0|async|bind)$' {
+                    $ga = $S33G[$id]
+                    $k = S33K $id "s33-row6-$ga" 'offsf' @("offsf=$s33o", "$ga=$c")
+                    # M10 C2: row 6 s33_fields (forced pipeline waits 0.0 ms total (0 calls) on every arm line), read by hand
+                    $fl = S33R $id 's33_fields' 's33fields' @('build\agent6\s33-popin\s33_fields.py', '--arm', "offsf=$s33o", '--arm', "$ga=$c", '--out', (Join-Path $logs "$id.s33fields.report.txt"))
+                    Say "s33 $id row 6: kit $k, s33_fields $fl"
+                }
