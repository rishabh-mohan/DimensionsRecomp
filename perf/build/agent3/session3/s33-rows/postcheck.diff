+# #33 rows 2, 4, 5, 6, (d) (M3 draft, build\agent3\session3\s33-rows\S33-ROWS-PLAN.md): the kit per row with explicit
+# arm=run pairs, ref = a cvar-off arm (never --allow-new for no_wait in the kit; TESTPLAN). Kit out to %TEMP%\m3-s33\<row>,
+# copied to checks\<row> only on kit exit 0/1 (M10 Q1/Q2). Every tool's exit goes into logs\<id>.s33.txt ("<tool> exit N").
+function S33K([string]$id, [string]$row, [string]$ref, [string[]]$arms) {
+    while (Test-Path -LiteralPath $hold) { Start-Sleep -Seconds 10 }
+    $f = Join-Path $logs "$id.s33.txt"
+    $miss = @($arms | Where-Object { $_ -match '=$' })
+    if ($miss.Count) { Say "s33 $id SKIP: no run for $($miss -join ' ')"; "SKIP: no run for $($miss -join ' ')" | Set-Content -LiteralPath $f; return 'SKIP' }
+    $tmp = Join-Path $env:TEMP "m3-s33\$row"
+    $dst = "build\agent3\s4b\checks\$row"
+    if (Test-Path -LiteralPath $tmp) { Remove-Item -LiteralPath $tmp -Recurse -Force }
+    if (Test-Path -LiteralPath $dst) { Remove-Item -LiteralPath $dst -Recurse -Force }
+    $ka = @(); foreach ($a in $arms) { $ka += @('--run', $a) }
+    $global:LASTEXITCODE = -1
+    & cmd /c build\agent6\s33-popin\RUN-S33-LOGDIFF.cmd @ka --ref $ref --matrix-json build\agent6\s33-popin\harness-s33.json --out $tmp *> $f
+    $x = $LASTEXITCODE
+    Add-Content -LiteralPath $f -Value "kit exit $x (RUN-S33-LOGDIFF, ref $ref; out %TEMP%\m3-s33\$row -> $dst)"
+    if ($x -eq 0 -or $x -eq 1) {
+        try { New-Item -ItemType Directory -Force -Path $dst -ErrorAction Stop | Out-Null
+              Copy-Item -Path (Join-Path $tmp '*') -Destination $dst -Recurse -Force -ErrorAction Stop }
+        catch { Add-Content -LiteralPath $f -Value "COPY FAILED: $($_.Exception.Message)"; $x = "$x/copy FAIL" }
+    }
+    return $x
+}
+# one report tool (python, BelowNormal via postcheck): stdout+stderr -> logs\<id>.<out>.txt, exit line -> logs\<id>.s33.txt
+function S33R([string]$id, [string]$tool, [string]$out, [string[]]$a) {
+    while (Test-Path -LiteralPath $hold) { Start-Sleep -Seconds 10 }
+    $global:LASTEXITCODE = -1
+    & python -B @a *> (Join-Path $logs "$id.$out.txt")
+    $x = $LASTEXITCODE
+    Add-Content -LiteralPath (Join-Path $logs "$id.s33.txt") -Value "$tool exit $x (logs\$id.$out.txt)"
+    return $x
+}
