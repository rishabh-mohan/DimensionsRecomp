+            if ($why) {
+                $r.killed = $why; $ended = $true; Stop-Tree $p $why $T0
+                foreach ($t in $tails) { try { Read-Tail $t $RLog $true } catch { } }
+                break
+            }
+            if ($TestFailAfter -gt 0 -and ((Now) - $T0).TotalSeconds -ge $TestFailAfter) { throw "simulated launcher error (dry-run hook -TestFailAfter $TestFailAfter)" }
+        }
+    } catch {
+        $r.killed = "launcher error while the runner was running ($($_.Exception.Message))"
+        try { Log "!!! $($r.killed)" 'Red' } catch { }
+    } finally {
+        # Also on Ctrl+C (no catch block runs then, but this does): the runner never runs unwatched.
+        if (-not $ended) {
+            if (-not $r.killed) { $r.killed = 'the launcher was interrupted (Ctrl+C?) while the runner was running' }
+            Stop-Tree $p $r.killed $T0
+        }
+    }
+    try { if ($p.WaitForExit(5000)) { $r.code = $p.ExitCode } } catch { }
+    return $r
