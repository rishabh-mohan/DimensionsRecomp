+    if ($floor) {
+        for ($walk = 1; $walk -le 3; $walk++) {
+            $d = $null
+            try { $d = Get-Descendants $P.Id $floor } catch { Log "!!! the process list could not be read ($($_.Exception.Message)): processes the runner started may still be running" 'Red'; break }
+            if (-not $d.Count) { if ($walk -eq 1) { Log 'the runner had no other processes running' }; break }
+            Log "killed (walk $walk): $((@($d | ForEach-Object { Stop-One $_ })) -join ', ')"
