-# Kills the runner's whole process tree (run-timing, the game, the drivers) and logs it. Real mode also kills a
-# legodimensions from build\agent2 that started during the window in this session but is no longer in the tree.
+# The runner's descendants from one Win32_Process snapshot, parents before children. A process counts as a child only if
+# it was created at or after its parent, so an older process whose parent PID was reused by the runner or by one of its
+# children is never followed (this replaces taskkill /T). The runner's own PID cannot be reused while the launcher holds
+# its handle. Throws if the snapshot fails.
+function Get-Descendants([int]$RootId, [datetime]$RootCreated) {
+    $kids = @{}
+    foreach ($x in @(Get-CimInstance -ClassName Win32_Process -Property ProcessId, ParentProcessId, CreationDate, Name -OperationTimeoutSec 20 -ErrorAction Stop)) {
+        if ($null -eq $x.CreationDate) { continue }
+        $k = [int]$x.ParentProcessId
+        if (-not $kids.ContainsKey($k)) { $kids[$k] = New-Object System.Collections.Generic.List[object] }
+        $kids[$k].Add($x)
+    }
+    $out = New-Object System.Collections.Generic.List[object]
+    $todo = New-Object System.Collections.Generic.Queue[object]; $todo.Enqueue(@{ id = $RootId; t = $RootCreated }); $seen = @{ $RootId = $true }
+    while ($todo.Count) {
+        $q = $todo.Dequeue()
+        if (-not $kids.ContainsKey($q.id)) { continue }
+        foreach ($c in $kids[$q.id]) {
+            $cid = [int]$c.ProcessId
+            if ($seen.ContainsKey($cid) -or $c.CreationDate -lt $q.t) { continue }
+            $seen[$cid] = $true; $out.Add($c); $todo.Enqueue(@{ id = $cid; t = $c.CreationDate })
+        }
+    }
+    return , $out
+}
+# Kills one process of the snapshot, only if its PID still belongs to it (same start time). Returns a short note.
+function Stop-One($X) {
+    $id = [int]$X.ProcessId; $n = "$($X.Name):$id"
+    $g = $null; try { $g = [Diagnostics.Process]::GetProcessById($id) } catch { return "$n (already gone)" }
+    try {
+        if ([math]::Abs(($g.StartTime - $X.CreationDate).TotalMilliseconds) -ge 2) { return "$n (left alone: the pid now belongs to another process)" }
+        $g.Kill(); [void]$g.WaitForExit(5000); return $n
+    } catch { return "$n (NOT killed: $($_.Exception.Message))" } finally { $g.Dispose() }
+}
