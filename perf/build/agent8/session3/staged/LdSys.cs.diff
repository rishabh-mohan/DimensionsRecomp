+            sGame = Math.Max(0, game - sysPrevGame) / dt;
+            sNongame = Math.Max(0.0, sBusy - sGame);
+        }
+        sysPrevBusy = busy; sysPrevGame = game; sysPrevQpc = q; sysHave = g;
+    }
