+// Config problems found before InitLogging (cvar::Init, ApplyEnvironment and
+// LoadConfig all run before it) reach only the early debugger sink, so a
+// rejected value such as present_effect = 'fsr' never shows up in game.log.
+// They are kept here and repeated by FlushDeferredConfigWarnings(), which
+// InitLogging calls once the real sinks exist. Later problems log directly.
+struct DeferredConfigWarning {
+  bool error;
+  std::string text;
+};
+
+std::mutex g_deferred_mutex;
+bool g_deferred_flushed = false;
+std::string g_config_file;  // The file LoadConfig is reading, for messages.
+
+std::vector<DeferredConfigWarning>& GetDeferredWarnings() {
+  static std::vector<DeferredConfigWarning> warnings;
+  return warnings;
+}
+
+void DeferConfigWarning(std::string text, bool error = false) {
+  std::lock_guard lock(g_deferred_mutex);
+  if (g_deferred_flushed) {
+    return;
+  }
+  auto& warnings = GetDeferredWarnings();
+  // ReXApp::SetupEnvironment usually loads the same file twice.
+  for (const auto& warning : warnings) {
+    if (warning.text == text) {
+      return;
+    }
+  }
+  warnings.push_back({error, std::move(text)});
+}
+
+const char* SourceName(Source source) {
+  switch (source) {
+    case Source::kDefault:
+      return "default";
+    case Source::kConfig:
+      return "config";
+    case Source::kEnvironment:
+      return "environment";
+    case Source::kCommandLine:
+      return "command line";
+    case Source::kRuntime:
+      return "runtime";
+  }
+  return "?";
+}
+
+std::string DescribeConstraints(const FlagEntry& entry) {
+  const auto& c = entry.constraints;
+  std::string text;
+  if (c.HasAllowedValues()) {
+    text = "allowed:";
+    for (const auto& allowed : c.allowed_values) {
+      text += (text.back() == ':' ? " " : ", ") + allowed;
+    }
+  } else if (c.HasRangeConstraint()) {
+    text = fmt::format("range {} to {}", c.min ? fmt::format("{}", *c.min) : "-inf",
+                       c.max ? fmt::format("{}", *c.max) : "inf");
+  } else if (c.custom_validator) {
+    text = "custom validator";
+  } else {
+    text = "unparseable value";
+  }
+  return text;
+}
