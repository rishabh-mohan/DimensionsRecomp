+// Called by InitLogging (logging.cpp) once the real sinks exist. Not declared
+// in rex/cvar.h, which is in every target's precompiled header.
+void FlushDeferredConfigWarnings() {
+  std::vector<DeferredConfigWarning> warnings;
+  {
+    std::lock_guard lock(g_deferred_mutex);
+    g_deferred_flushed = true;
+    warnings.swap(GetDeferredWarnings());
+  }
+  for (const auto& warning : warnings) {
+    if (warning.error) {
+      REXLOG_ERROR("{} (reported before logging started)", warning.text);
+    } else {
+      REXLOG_WARN("{} (reported before logging started)", warning.text);
+    }
+  }
+}
