 Exit 0 = every gate PASS. --selftest A1=<dir> T1=<dir> ...: parse only (no gates), for the dry run.
@@ -53,6 +54,7 @@ L_LOG = 'd3d12_log_sync_pipeline_creation:'
 L_NW_ON = 'd3d12_pipeline_creation_no_wait: not waiting'
 L_NW_IGN = 'd3d12_pipeline_creation_no_wait ignored'
 L_FAILED = 'Failed to create graphics pipeline'
+L_HARD_EXIT = 'Title terminated; hard-exiting process'
 SYNC_RE = re.compile(r'\[t(\d+)\] sync pipeline #(\d+) ([0-9A-F]{16}): ([\d.]+) ms \(([^)]*)\) \| vs ([0-9A-F]{16}) '
                      r'\(host type (\d+)\) ps (\S+) \| memexport vs ([0-9A-F]+) ps ([0-9A-F]+) \| ([^|]+?) \| '
                      r'rt bits ([0-9A-F]+) color mask ([0-9A-F]+) z (\d+) write (\d+) \| prim (\d+) \| (\w+) \| '
@@ -205,8 +207,15 @@ def zpd_report(arm, lines, g):
             else:
                 say('UNPARSED occlusion line: %s' % l[:160])
     # Z4 (M10 zpd-log rating): every run logs one "shutdown" line; a "first" line means the route issued ZPDs.
-    check('%s Z4 occlusion-query "shutdown" line once' % arm, sum(r['when'] == 'shutdown' for r in rows) == 1,
-          '%d lines, %s' % (len(rows), dict(Counter(r['when'] for r in rows))), g)
+    # On WM_CLOSE the title hard-exits ('Title terminated; hard-exiting process') before the GPU shutdown runs, so
+    # with that line in the log and no shutdown line, the last counter line (normally periodic) stands in.
+    n_sd, cnt = sum(r['when'] == 'shutdown' for r in rows), dict(Counter(r['when'] for r in rows))
+    if n_sd == 0 and rows and any(L_HARD_EXIT in l for l in lines):
+        check('%s Z4 occlusion-query "shutdown" line once' % arm, True,
+              'shutdown line absent: hard-exit; counters from the last line (%s, frame %d); %d lines, %s' % (
+                  rows[-1]['when'], rows[-1]['frame'], len(rows), cnt), g)
+    else:
+        check('%s Z4 occlusion-query "shutdown" line once' % arm, n_sd == 1, '%d lines, %s' % (len(rows), cnt), g)
     if not rows:
         say('  S1: no occlusion counter lines (no ZPD packet and no shutdown line): unknown')
         return None
diff --git a/pins-test/synth-prev.py b/nops-smoke/synth/synth_post.py
index 5a9d316..51ed9d4 100644
--- a/pins-test/synth-prev.py
+++ b/nops-smoke/synth/synth_post.py
@@ -38,6 +38,16 @@ assert not post.fails, post.fails
 post.zpd_report('T2', [z('first', 1, 0, 1, 0, 0)], True)
 assert len(post.fails) == 1 and 'Z4' in post.fails[0], post.fails
 del post.fails[:]
+# Z4 hard exit: no shutdown line + the hard-exit line -> the last periodic line stands in (PASS); without the
+# hard-exit line, or with no counter lines at all, Z4 still FAILs
+HX = '[core] [t1] Title terminated; hard-exiting process.'
+r = post.zpd_report('T2', [z('first', 1, 0, 1, 0, 0), z('disabled', 2, 0, 1, 0, 1), z('periodic', 900, 898, 1, 0, 1), HX], True)
+assert not post.fails and r['zpd'] == 900 and r['s1'].startswith('0 NOT valid'), (post.fails, r)
+assert any('shutdown line absent: hard-exit' in s and '(periodic, frame 1)' in s for s in post.out_lines), post.out_lines[-6:]
+post.zpd_report('T2', [z('first', 1, 0, 1, 0, 0), z('periodic', 900, 898, 1, 0, 1)], True)
+post.zpd_report('T2', ['noise', HX], True)
+assert len(post.fails) == 2 and all('Z4' in f for f in post.fails), post.fails
+del post.fails[:]
 # negative: old storage file, a black shot
 os.utime(os.path.join(rd, 'user', 'cache', 'shaders', 'shareable', 'x.xsh'), (t0 - 100, t0 - 100))
 with open(os.path.join(rd, 'kit-shots', 'shots.txt'), 'a') as f:
