+// The d3d12_log_occlusion_queries counters. A draw dropped while its pipeline
+// is pending adds no samples to an active query, so the guest reads a low
+// count. GPU Commands thread only, one command processor per process, so file
+// scope is enough. The counters are always kept; only the log is optional.
+struct OcclusionQueryLog {
+  uint64_t zpd = 0;                  // EVENT_WRITE_ZPD packets
+  uint64_t zpd_no_host = 0;          // ... while host queries are off or unavailable
+  uint64_t begun = 0;                // host queries begun
+  uint64_t resolved = 0;             // host sample counts written to the guest
+  uint64_t fallback = 0;             // fallback (fake) results written to the guest
+  uint64_t disabled = 0;             // host queries disabled (DisableHostOcclusionQueries)
+  const char* disable_reason = "";
+  uint64_t ended_by_submission = 0;  // queries ended early by EndSubmission
+  uint64_t draws_in_query = 0;       // draws reaching the pipeline check in a query
+  uint64_t dropped_in_query_ps = 0;  // ... dropped while their pipeline is pending
+  uint64_t dropped_in_query_no_ps = 0;
+  std::chrono::steady_clock::time_point last_log{};
+};
+OcclusionQueryLog occlusion_query_log;
+
+void LogOcclusionQueries(const char* when, uint64_t frame) {
+  if (!REXCVAR_GET(d3d12_log_occlusion_queries)) {
+    return;
+  }
+  OcclusionQueryLog& q = occlusion_query_log;
+  q.last_log = std::chrono::steady_clock::now();
+  REXGPU_INFO(
+      "d3d12_occlusion_queries ({}): frame={} zpd={} zpd_no_host={} begun={} resolved={} "
+      "fallback={} disabled={} reason='{}' ended_by_submission={} draws_in_query={} "
+      "dropped_in_query_ps={} dropped_in_query_no_ps={}",
+      when, frame, q.zpd, q.zpd_no_host, q.begun, q.resolved, q.fallback, q.disabled,
+      q.disable_reason, q.ended_by_submission, q.draws_in_query, q.dropped_in_query_ps,
+      q.dropped_in_query_no_ps);
+}
+
+// Counts one ZPD packet, and logs when the handler returns: on the first
+// packet, after a disable, or 10 s after the last line.
+struct OcclusionQueryPacketScope {
+  explicit OcclusionQueryPacketScope(uint64_t frame_in)
+      : frame(frame_in), disabled_before(occlusion_query_log.disabled) {
+    ++occlusion_query_log.zpd;
+  }
+  ~OcclusionQueryPacketScope() {
+    const OcclusionQueryLog& q = occlusion_query_log;
+    if (q.zpd == 1) {
+      LogOcclusionQueries("first", frame);
+    } else if (q.disabled != disabled_before) {
+      LogOcclusionQueries("disabled", frame);
+    } else if (std::chrono::steady_clock::now() - q.last_log >= std::chrono::seconds(10)) {
+      LogOcclusionQueries("periodic", frame);
+    }
+  }
+  uint64_t frame;
+  uint64_t disabled_before;
+};
+
