+// d3d12_log_sync_pipeline_creation, latched in PipelineCache::Initialize. Only
+// the command thread creates pipelines synchronously (ConfigurePipeline), so
+// the counters and the rate limit below need no locking.
+bool log_sync_pipeline_creation = false;
+constexpr uint32_t kSyncPipelineLogLinesPerSecond = 32;
+uint64_t sync_pipeline_count = 0;
+uint64_t sync_pipeline_total_us = 0;
+int64_t sync_pipeline_log_second = -1;
+uint32_t sync_pipeline_log_lines = 0;
+uint64_t sync_pipeline_log_suppressed = 0;
+
+// Counts a synchronous creation; returns whether it may be logged.
+bool CountSyncPipelineCreation(uint64_t us) {
+  ++sync_pipeline_count;
+  sync_pipeline_total_us += us;
+  int64_t second = std::chrono::duration_cast<std::chrono::seconds>(
+                       std::chrono::steady_clock::now().time_since_epoch())
+                       .count();
+  if (second != sync_pipeline_log_second) {
+    sync_pipeline_log_second = second;
+    sync_pipeline_log_lines = 0;
+  }
+  if (sync_pipeline_log_lines >= kSyncPipelineLogLinesPerSecond) {
+    ++sync_pipeline_log_suppressed;
+    return false;
+  }
+  ++sync_pipeline_log_lines;
+  return true;
+}
+
