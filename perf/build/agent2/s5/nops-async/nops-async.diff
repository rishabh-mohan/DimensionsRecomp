+// With async_shader_compilation, ConfigurePipeline creates a pipeline without
+// a pixel shader (depth-only) on the command thread, which stalls the frame.
+// With this on, such a pipeline is created on the creation threads instead,
+// like one with a pixel shader, and its draws are skipped until it's ready.
+// Its vertex shader is still translated on the command thread, so the root
+// signature is final when the pipeline is queued. Not for vertex shaders that
+// memexport (skipping them would lose data the guest reads) or for the ROV
+// path. Read once, in PipelineCache::Initialize.
+REXCVAR_DEFINE_BOOL(d3d12_async_depth_only_pipelines, false, "GPU/D3D12",
+                    "With async_shader_compilation, also create pipelines without a pixel shader "
+                    "(depth-only) on the creation threads: their draws are skipped until ready "
+                    "instead of stalling the frame. Not for memexport vertex shaders or ROV")
+    .lifecycle(rex::cvar::Lifecycle::kRequiresRestart);
+
+namespace {
+// d3d12_async_depth_only_pipelines, latched in PipelineCache::Initialize.
+bool async_depth_only_pipelines = false;
+}  // namespace
+
 // With async_shader_compilation, a draw whose pipeline is still being created
