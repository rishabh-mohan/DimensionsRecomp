--- build/agent2/rb-chain.ps1.pre-GuardOnly
+++ build/agent2/rb-chain.ps1
@@ -13,8 +13,9 @@
 #    rb-chain-<v>-prep.log.
 # 3. run-<v>.ps1 -Jobs N [-NoBuild]: the pins again, configure, gen-check, gate, build, stage with its -CompareBin
