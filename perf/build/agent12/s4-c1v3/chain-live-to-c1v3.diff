+  uint64_t blocks_uploaded[kBlockCount / 64] = {};
+  uint64_t blocks_changed[kBlockCount / 64] = {};
+  uint32_t block_pages_rehashed[kBlockCount] = {};  // re-uploaded pages (not first) per block
+};
