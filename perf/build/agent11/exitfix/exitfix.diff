diff --git a/DimensionsRecomp/rexglue-sdk/src/kernel/xboxkrnl/xboxkrnl_hal.cpp b/DimensionsRecomp/rexglue-sdk/src/kernel/xboxkrnl/xboxkrnl_hal.cpp
index 2575f9d..6204e88 100644
